# Local Postgres via docker-compose
DATABASE_URL="postgresql://pool:pool@localhost:5433/poolforge"

# Auth.js
# AUTH_URL must match the origin the browser loads from.
#   Web (next dev):       http://localhost:3000
#   Web (deployment):     <your public URL>
#   Electron dev:         http://localhost:3001 (set automatically by electron/main.cjs)
#   Electron production:  http://127.0.0.1:3010 (set automatically by electron/main.cjs)
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Google OAuth (deferred — leave empty until Track B activates the provider)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
