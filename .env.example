# Local Postgres via docker-compose
DATABASE_URL="postgresql://pool:pool@localhost:5433/poolforge"

# Auth.js
# AUTH_URL must match the origin the browser loads from.
#   Web (next dev):       http://localhost:3000
#   Web (deployment):     <your public URL>
#   Electron dev:         http://localhost:3001 (set automatically by electron/main.cjs)
#   Electron production:  http://127.0.0.1:3010 (set automatically by electron/main.cjs)
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Google OAuth (deferred — leave empty until Track B activates the provider)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Blob storage for image ingestion. `local` writes under .data/blobs (gitignored),
# sharded by sha256 prefix. A GCS driver lands with Wave 2 T8.
BLOB_STORE_DRIVER="local"
BLOB_STORE_LOCAL_DIR=".data/blobs"

# Vertex AI (image ingestion, Track I2)
# Vertex AI only. The consumer generativelanguage.googleapis.com endpoint permits
# Google to use prompts for training and these are photographs of customers' homes.
# Auth is Application Default Credentials: `gcloud auth application-default login`
# locally, the runtime service account in deployment. No key files in this repo.
GCP_PROJECT_ID="pool-forge-prod"
VERTEX_LOCATION="us-central1"

# Cheap model for CLASSIFY, strong model for EXTRACT.
VERTEX_CLASSIFY_MODEL="gemini-2.5-flash"
VERTEX_EXTRACT_MODEL="gemini-2.5-pro"

# Per-call ceiling and bounded retries on 429/5xx.
# 180s, not 60s: a real gemini-2.5-pro sketch extraction measured 41 to 46
# seconds, and a 60s ceiling produced 504 DEADLINE_EXCEEDED on all three
# attempts while the same call succeeded directly.
VERTEX_TIMEOUT_MS="180000"
VERTEX_MAX_ATTEMPTS="3"

# Live calls are opt-in. Unset or "0" replays recorded fixture responses and
# never touches the network. pool-forge-prod has been billed since 2026-08-19.
VERTEX_LIVE="0"

# --- Voice agent (Gemini Live over Vertex) ---
# Off by default: a live session bills continuously for as long as it is open.
# Needs working ADC, same as the vision client above.
VOICE_LIVE="0"
# Live model ids are preview and churn. `pnpm voice:models` opens a session
# against each candidate and reports which the project can actually reach,
# which is the difference between a retired id and broken access when both
# arrive as a 404.
VERTEX_LIVE_MODEL="gemini-live-2.5-flash-native-audio"
# A live session bills continuously for as long as it is open, so both of these
# are ceilings rather than tuning knobs. Enforced per organisation under a
# database lock, not in memory: N instances each holding a local counter
# collectively allow N times the intended limit.
VOICE_MAX_CONCURRENT="3"
VOICE_MAX_MINUTES_PER_DAY="120"

# --- Voice relay (web only; the desktop build needs none of this) ---
# The browser cannot talk to Vertex: ephemeral tokens are a Gemini Developer API
# feature and Vertex has none, and Vertex auth is ADC, which must never reach a
# browser. So a relay is the only shape this can take.
#
# Shared between the app (which mints tickets) and the relay (which checks them).
# At least 32 characters. The relay refuses to boot without it rather than
# running on a default and accepting forged tickets while looking healthy.
VOICE_TICKET_SECRET=""
# Where the browser connects. Baked at build time like every NEXT_PUBLIC_ var, so
# it must be wired through Dockerfile ARG/ENV and the build args, not just here.
# Leave empty to disable web voice; the desktop build is unaffected either way.
NEXT_PUBLIC_VOICE_RELAY_URL=""

# Optional fallback header for the intake rate limiter's client-IP bucket, used
# only when X-Forwarded-For is absent. Leave unset unless a proxy you control
# sets the header; otherwise a caller can forge it and mint a fresh bucket per
# request. Example behind Cloudflare: "cf-connecting-ip".
INTAKE_TRUSTED_IP_HEADER=""

# --- Error monitoring ---
# Every unhandled server error and every browser error boundary produces one
# redacted JSON line on stderr carrying an `err_<12 hex>` reference. That works
# with nothing set here, in development, in CI and in production, because the
# host already collects stdout. Nothing below is required for the app to run or
# for the test suite to pass.
#
# Optional: an alert sink so somebody hears about an error rather than having to
# go looking. Any endpoint that accepts a JSON POST works, including a Slack or
# Discord incoming webhook. Must be https. Leave empty to disable alerting
# entirely, which is the default and is a reasonable answer for a single-user
# beta whose logs somebody reads.
#
# What crosses the wire is the redacted record minus the stack: a reference, an
# error class, a masked route, a fingerprint and a timestamp. Never a message
# with a customer's name, address or contract figure in it (see
# src/modules/monitoring/redact.ts and its tests). Even so, this is a third
# party, so point it somewhere you control if that matters to you.
MONITORING_ALERT_WEBHOOK_URL=""

# Label distinguishing one deployment from another in the logs and in alerts.
# Defaults to NODE_ENV when unset.
MONITORING_ENV=""

# Optional build identifier, usually the git sha, so an error can be tied to the
# code that produced it. Set it in the deploy, not by hand.
MONITORING_RELEASE=""

# --- Backups (scripts/backup-*.sh, scripts/verify-restore.sh) ---
# Where dumps and blob archives are written, and how long they are kept.
# See docs/backup-restore.md for the runbook and the verified restore drill.
BACKUP_DIR=".backups"
BACKUP_RETENTION_DAYS="14"
# Postgres client image used when the local pg_dump/pg_restore are older than
# the server. Must match the server major version.
PG_IMAGE="postgres:16-alpine"
